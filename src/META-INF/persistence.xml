<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="foodstorePU-mysql">
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/foodstore_prog2"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <!-- Reemplazar solo en el equipo local. Nunca publicar credenciales reales. -->
            <property name="jakarta.persistence.jdbc.password" value="CAMBIAR_LOCALMENTE"/>
        </properties>
    </persistence-unit>
</persistence>
